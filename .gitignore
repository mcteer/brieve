# macOS
.DS_Store

# Spec Kit / AI coding agent local command directories (per-developer; .specify/ is committed)
.claude/
.cursor/
.windsurf/
.gemini/
.github/agents/
.github/prompts/
.github/skills/
.specify/integrations/.cache/

# Python / tooling
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/
*.egg-info/
.eggs/
*.egg
# Keep the lockfile: uv.lock is committed

# Node / portal (future)
node_modules/
.next/
.turbo/

# Terraform — state may contain secrets; provider plugins are large and platform-specific
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Local approval mockups — not product artifacts (048 FR-016)
tmp-ui-mockups/

# Env and local secrets — never commit
.env
.env.*
!.env.example

# GEPA run traces (049 eval-lane). Candidates themselves may be reviewed; logs are not.
evals/prompt-tune/candidates/**/gepa-log/
evals/prompt-tune/candidates/**/joint-gepa-log/
evals/prompt-tune/candidates/run.log
evals/prompt-tune/candidates/.dspy-cache/
evals/prompt-tune/sc006-*.log

# Editor
*.swp
*.swo
.idea/
.vscode/
*.iml
.enclave/

# 024: raw upstream HTML, kept only so `corpus-sync` can recompute digests. The corpus itself is
# VENDORED as extracted sections under `corpus/documents/` and is committed; this is the markup
# those were extracted from, which is fourteen megabytes of navigation nobody reads.
.corpus-cache/
