#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# Fetch the guidance corpus into a LOCAL CACHE and pin it by content digest.
#
# **THE CONTENT IS NOT VENDORED, AND THAT IS A DEVIATION FROM THE PLAN.** 024's T004 said to
# vendor the corpus the way `packs/terraform/skills/` vendors upstream skills. That precedent
# works because those skills come from a repository with a licence permitting it — MPL-2.0,
# copied verbatim beside the content. That is this repository's bar: vendor when you hold a
# licence. The content here is vendored on the maintainer's call: publicly accessible pages, a
# HashiCorp-endorsed project. An earlier version of this comment claimed the licence could not be
# checked because the GitHub API 403s for the hashicorp org — that is SAML rejecting a token, not
# a private repo, and unauthenticated the same repos answer fine. See corpus/PROVENANCE.md.
#
# So the pin is a MANIFEST rather than a copy: URL, content digest, and section anchors. The
# digest is the pin — which is exactly what FR-014 asks for, since the corpus carries no version
# metadata anywhere and change can only be detected by content.
#
# The cache is gitignored. Answering reads it and verifies each digest against the manifest;
# nothing is fetched at answer time, which is what the plan rejected and this preserves.
set -uo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
exec uv run --extra surfaces python "$REPO/infra/bin/corpus_sync.py" "$@"
