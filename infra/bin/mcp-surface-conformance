#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# 019's lane — the rows that drive the SERVED surface.
#
# 017's shape, for 017's reason: rows against a running process need something to stand that
# process up, and a lane that assumed one was already there would pass or fail on whatever a
# developer happened to have running.
#
# NOT the `host_enclave` pytest line. These rows need the surface standing, and
# `tests/conformance/deployment` is absent from that line for the same reason. A directory
# named there would be collected with nothing serving.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
MARK="mcp-surface-conformance"
IDP_PORT="${DEV_IDP_PORT:-8090}"

# THE ISSUER MUST BE A NAME BOTH SIDES CAN USE, and this is the whole subtlety of the lane.
#
# The rows walk the provider's flow from the developer's machine, where it is `127.0.0.1`.
# The surface fetches JWKS from inside a BRIDGE container, where `127.0.0.1` is the container
# itself and the machine is `host.docker.internal`. The token's `iss` claim is a single
# string checked for equality — so if the provider announces loopback, the surface rejects
# every token with an issuer mismatch that names the issuer rather than the topology.
#
# So the provider announces the name the surface will use, and the rows redeem against
# loopback. Two addresses, one issuer.
# WHAT THE PROVIDER MINTS AND WHAT A CLIENT RESOLVES — a loopback address, because a browser
# login happens on the host and `host.docker.internal` does not resolve there.
IDP_ISSUER="http://127.0.0.1:${IDP_PORT}"
# WHERE THE SURFACE FETCHES KEYS — from inside its container, which is the one place the name
# above cannot be reached from. Separate values on purpose; see the note in `mcp-surface-up`.
IDP_JWKS_URI="http://host.docker.internal:${IDP_PORT}/jwks"

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
ok() { printf '    \033[32mok\033[0m %s\n' "$*"; }
note() { printf '    \033[33m--\033[0m %s\n' "$*"; }
die() {
  printf '\033[31mthe mcp-surface lane could not run:\033[0m %s\n' "$*" >&2
  exit 1
}

cleanup() {
  local status=$?
  if [ -n "${IDP_PID:-}" ] && kill -0 "$IDP_PID" 2>/dev/null; then
    kill "$IDP_PID" 2>/dev/null || true
    ok "stopped the development identity provider (pid ${IDP_PID})"
  fi
  # Only what THIS run started. A developer's own surface carries no mark and survives —
  # 017's rule, because a lane that stopped everything would take someone's work with it.
  if [ "$(nomad job inspect mcp-surface 2>/dev/null | python3 -c 'import json,sys
try: print((json.load(sys.stdin)["Job"]["Meta"] or {}).get("harness_started_by",""))
except Exception: print("")' 2>/dev/null)" = "$MARK" ]; then
    nomad job stop -purge mcp-surface >/dev/null 2>&1 || true
    ok "stopped what this run started"
  else
    note "left mcp-surface running — it carries no mark from this lane"
  fi
  exit "$status"
}
trap cleanup EXIT

say "Development identity provider"
if curl -sf "http://127.0.0.1:${IDP_PORT}/jwks" >/dev/null 2>&1; then
  ok "already listening on ${IDP_PORT}"
else
  (
    cd "$REPO"
    DEV_IDP_HOST=0.0.0.0 DEV_IDP_PORT="$IDP_PORT" DEV_IDP_ISSUER="$IDP_ISSUER" \
      uv run --extra surfaces python -m tests.harness.dev_idp >/tmp/brieve-mcp-idp.log 2>&1 &
    echo $! >/tmp/brieve-mcp-idp.pid
  )
  IDP_PID="$(cat /tmp/brieve-mcp-idp.pid)"
  for _ in $(seq 1 30); do
    curl -sf "http://127.0.0.1:${IDP_PORT}/jwks" >/dev/null 2>&1 && break
    sleep 1
  done
  curl -sf "http://127.0.0.1:${IDP_PORT}/jwks" >/dev/null 2>&1 \
    || die "the development provider never answered — see /tmp/brieve-mcp-idp.log"
  ok "listening on 0.0.0.0:${IDP_PORT}, issuer ${IDP_ISSUER}"
fi

say "Standing up the served surface"
HARNESS_STARTED_BY="$MARK" \
  OIDC_ISSUER_OVERRIDE="$IDP_ISSUER" \
  OIDC_JWKS_URI_OVERRIDE="$IDP_JWKS_URI" \
  bash "$REPO/infra/bin/mcp-surface-up" >/dev/null \
  || die "mcp-surface-up failed"

for _ in $(seq 1 60); do
  alloc="$(nomad job allocs -json mcp-surface 2>/dev/null | python3 -c 'import json,sys
try:
    a=[x for x in json.load(sys.stdin) if x["ClientStatus"]=="running"]
    print(a[0]["ID"] if a else "")
except Exception: print("")' 2>/dev/null)"
  if [ -n "$alloc" ] && nomad alloc logs "$alloc" server 2>/dev/null | grep -q "mcp surface ready"; then
    break
  fi
  sleep 5
done
[ -n "${alloc:-}" ] || die "the surface never reached a running allocation"
nomad alloc logs "$alloc" server 2>/dev/null | grep -q "mcp surface ready" \
  || die "the surface is placed but not answering — its own output: $(nomad alloc logs -stderr "$alloc" server 2>&1 | tail -20)"
ok "surface answering ($alloc)"

say "Rows against the served process"
cd "$REPO"
DEV_IDP_ISSUER="http://127.0.0.1:${IDP_PORT}" \
  uv run --extra surfaces --extra adapters pytest tests/conformance/mcp_served -q \
  || die "the lane failed — the rows' output is above"
ok "mcp-surface lane passed"
