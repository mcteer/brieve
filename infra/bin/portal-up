#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# Stand up the surfaces a PERSON uses: a development identity provider, the northbound
# API, and the portal. Deliberately separate from `make dev-up`.
#
# Bring-up stands up the platform, and every gate reaches Vault, Nomad, Postgres, the MCP
# service, and agent-run. These three serve a browser. Keeping them apart is not tidiness:
# registering them at bring-up blocked the enclave CI lane for ten minutes on a service
# deployment, and their resource reservations left the conformance job unplaceable, so the
# merge-blocking durability rows never ran.
#
# It is also more honest. The portal login needs an identity provider that AUTHENTICATES
# NOBODY, and running one should be something a person chooses rather than something that
# happens to them.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$REPO"

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
ok()  { printf '    \033[32mok\033[0m %s\n' "$*"; }
die() { printf '\033[31mcould not start the surfaces:\033[0m %s\n' "$*" >&2; exit 1; }

command -v nomad >/dev/null 2>&1 || die "nomad is not on PATH — run \`make dev-up\` first"
nomad node status >/dev/null 2>&1 || die "the enclave is not up — run \`make dev-up\` first"

DEV_IDP_PORT="${DEV_IDP_PORT:-8090}"

# Ownership, for 017's deployment lane. EMPTY when a person runs this, which is the point:
# an unmarked surface is theirs and the lane will never stop it. The lane sets this so what
# it starts is identifiable by a LATER invocation — see infra/bin/deployment-marks.
HARNESS_STARTED_BY="${HARNESS_STARTED_BY:-}"

# Which identity provider these surfaces authenticate against.
#
# A real one when `.env` names an AUTH0_DOMAIN, the development double otherwise. The
# fallback is deliberate and so is its noisiness: the double AUTHENTICATES NOBODY, and an
# operator who believed they were federated when they were not is the unstated posture
# this platform legislates against everywhere else. It says which one it is, every time,
# rather than leaving it to be inferred from whether a sign-in page looks familiar.
# A key that is not there is an ANSWER, not a failure. Under `set -euo pipefail` a `grep`
# that matches nothing exits 1, `pipefail` propagates it, and `VAR="$(env_val KEY)"` then
# kills the script — so this died on its first line in any environment whose .env lacks the
# key it was asked for. Locally that never happened, because the key was always there; CI
# writes a minimal .env and portal-up exited in 160ms having done nothing.
#
# Found by 017's lane running this script in CI, which is the first time anything had.
env_val() {
  [ -f "$REPO/.env" ] || return 0
  grep "^$1=" "$REPO/.env" 2>/dev/null | head -1 | cut -d= -f2- | sed -e 's/^"//' -e 's/"$//' || true
}

AUTH0_DOMAIN="$(env_val AUTH0_DOMAIN)"

if [ -n "$AUTH0_DOMAIN" ]; then
  say "Identity provider: Auth0 (${AUTH0_DOMAIN})"

  # The trailing slash is Auth0's, and it is not cosmetic: the `iss` claim carries it, and
  # a verifier configured without it refuses every token as `unverifiable_identity` —
  # naming the token rather than the one character of configuration that is wrong.
  OIDC_ISSUER="https://${AUTH0_DOMAIN}/"
  OIDC_JWKS_URI="https://${AUTH0_DOMAIN}/.well-known/jwks.json"
  OIDC_AUTHORIZE="https://${AUTH0_DOMAIN}/authorize"
  OIDC_TOKEN="https://${AUTH0_DOMAIN}/oauth/token"

  # The API identifier, NOT the client id. Auth0 issues an opaque token — not a JWT at all
  # — when no audience is requested, and the failure surfaces as a malformed token.
  OIDC_AUDIENCE="$(env_val AUTH0_API_AUDIENCE)"
  [ -n "$OIDC_AUDIENCE" ] \
    || die "AUTH0_API_AUDIENCE is not set in .env. Without an audience Auth0 issues an opaque token rather than a JWT, and the surface refuses it as malformed."

  PORTAL_CLIENT_ID="$(env_val AUTH0_PORTAL_CLIENT_ID)"
  [ -n "$PORTAL_CLIENT_ID" ] || die "AUTH0_PORTAL_CLIENT_ID is not set in .env"

  # Namespaced because Auth0 — and Okta, and Ping — refuse to mint a bare custom claim.
  # There is no provider-neutral name for this, which is why it is configuration.
  OIDC_TENANT_CLAIM="$(env_val OIDC_TENANT_CLAIM)"
  [ -n "$OIDC_TENANT_CLAIM" ] \
    || die "OIDC_TENANT_CLAIM is not set in .env. Auth0 emits no bare \`tenant\` claim, so the surface refuses every token as \`no_tenant\` without this."

  ok "issuer ${OIDC_ISSUER}"
  ok "audience ${OIDC_AUDIENCE}"
  ok "tenant claim ${OIDC_TENANT_CLAIM}"
  ok "portal client ${PORTAL_CLIENT_ID} (public — PKCE, no secret)"
else
  say "Development identity provider (DEV ONLY — authenticates nobody)"
  if curl -sf "http://127.0.0.1:${DEV_IDP_PORT}/jwks" >/dev/null 2>&1; then
    ok "already listening on ${DEV_IDP_PORT}"
  else
    nohup uv run --extra adapters --extra surfaces --extra portal \
      python -m tests.harness.dev_idp >/tmp/brieve-dev-idp.log 2>&1 &
    # Recorded so whoever started it can stop it. This is a HOST process that outlives the
    # script, and left running it holds the uv cache lock — which fails an automated lane in
    # its post-job cleanup, with no test having failed and nothing in the diff to blame.
    printf '%s\n' "$!" > "${TMPDIR:-/tmp}/brieve-dev-idp.pid"
    for _ in $(seq 1 120); do
      curl -sf "http://127.0.0.1:${DEV_IDP_PORT}/jwks" >/dev/null 2>&1 && break
      sleep 0.5
    done
    curl -sf "http://127.0.0.1:${DEV_IDP_PORT}/jwks" >/dev/null 2>&1 \
      || die "the development identity provider did not come up — see /tmp/brieve-dev-idp.log"
    ok "listening on ${DEV_IDP_PORT}"
  fi

  OIDC_ISSUER="http://127.0.0.1:${DEV_IDP_PORT}"
  OIDC_JWKS_URI="http://127.0.0.1:${DEV_IDP_PORT}/jwks"
  OIDC_AUTHORIZE="http://127.0.0.1:${DEV_IDP_PORT}/authorize"
  OIDC_TOKEN="http://127.0.0.1:${DEV_IDP_PORT}/token"
  OIDC_AUDIENCE="harness-api"
  OIDC_TENANT_CLAIM="tenant"
  PORTAL_CLIENT_ID="harness-portal"
fi

# `-detach`, because `nomad job run` on a SERVICE job blocks until its deployment settles.
# Without it a service that cannot start holds this script for as long as Nomad keeps
# trying, and the failure reads as a hang rather than as a failure.
say "API service"
# 027. Which model `ask` may call, from .env — the same variable `mcp-surface-up` passes, because
# the two deployed surfaces must take the same configuration or ADR-0033's parity guarantee is a
# statement about a test fixture rather than about a deployment. The credential is never passed
# here; the surface reads it from the trust store per ask.
ASK_MODEL="$(env_val ASK_MODEL)"
nomad job run -detach -var="repo=$REPO" \
  -var="ask_model=${ASK_MODEL}" \
  -var="oidc_issuer=${OIDC_ISSUER}" \
  -var="oidc_jwks_uri=${OIDC_JWKS_URI}" \
  -var="oidc_audience=${OIDC_AUDIENCE}" \
  -var="oidc_tenant_claim=${OIDC_TENANT_CLAIM}" \
  -var="harness_started_by=${HARNESS_STARTED_BY}" \
  "$REPO/infra/jobs/api.nomad.hcl" >/dev/null \
  && ok "api submitted (the northbound surface, served for the first time in 012)" \
  || die "could not submit the api service"

say "Portal"

# THE PORTAL'S TLS CERTIFICATE, ISSUED BY THE CONTROL PLANE'S OWN CA.
#
# The session cookie is `__Host-` prefixed and therefore `Secure`, and `Secure` over plain
# HTTP is accepted by Chromium and Firefox on loopback and REFUSED BY SAFARI. The symptom is
# the cruellest available: sign-in succeeds, the callback returns 303, the cookie is silently
# discarded, and the portal renders its own sign-in page again. Observed 2026-07-31 with an
# empty Safari cookie store.
#
# Issued fresh on every bring-up rather than kept: it costs one API call, it cannot expire in
# a drawer, and it means nobody has to know it exists to get a working portal.
PORTAL_CRT="$REPO/.enclave/portal.crt"
PORTAL_KEY="$REPO/.enclave/portal.key"
# The coordinates come from `.env` through this script's own reader, which is the only thing
# here that knows where `.env` is. The first version of this block assumed VAULT_ADDR and a
# token were already exported; nothing in `portal-up` exports either, so `vault` ran with no
# address and failed producing NO OUTPUT AT ALL — and the die message discarded what little
# there was. Both halves are fixed: the values are read the way every other value here is
# read, and the message carries the cause.
# THE COORDINATES, AND THEIR FALLBACKS, WHICH ARE THE PART THAT MATTERS.
#
# `enclave-up` writes VAULT_ROOT_TOKEN into `.env` but only EXPORTS the address and the CA
# path — so a developer's `.env` has all three and CI's has one. Reading all three from
# `.env` worked perfectly here and would have failed in CI with a TLS error naming the
# certificate rather than the missing setting.
#
# The defaults are `enclave-up`'s own, copied deliberately rather than invented: if it moves
# the CA, this follows by being wrong in the same direction, which is easier to find than
# being wrong in a new one.
_vault_addr="$(env_val VAULT_ADDR)"; _vault_addr="${_vault_addr:-https://127.0.0.1:8200}"
_vault_cacert="$(env_val VAULT_CACERT)"; _vault_cacert="${_vault_cacert:-$REPO/.enclave/ca.pem}"
_vault_token="$(env_val VAULT_ROOT_TOKEN)"
[ -n "$_vault_token" ] || die "VAULT_ROOT_TOKEN is not in .env — the portal's certificate cannot be issued. Has enclave-up run?"

if ! _cert=$(VAULT_ADDR="$_vault_addr" VAULT_CACERT="$_vault_cacert" VAULT_TOKEN="$_vault_token" \
      vault write -format=json \
      pki/issue/control-plane \
      common_name="localhost" \
      ip_sans="127.0.0.1" \
      alt_names="localhost,host.docker.internal" \
      ttl="8760h" 2>&1); then
  die "could not issue the portal's certificate — it would serve plain HTTP and sign nobody in: ${_cert}"
fi
printf '%s' "$_cert" | python3 -c '
import json, os, sys
d = json.load(sys.stdin)["data"]
crt, key = sys.argv[1], sys.argv[2]
open(crt, "w").write(d["certificate"] + "\n" + "\n".join(d.get("ca_chain", [])))
open(key, "w").write(d["private_key"])
os.chmod(key, 0o600)
' "$PORTAL_CRT" "$PORTAL_KEY" || die "could not write the portal certificate"
unset _cert _vault_addr _vault_cacert _vault_token
ok "portal certificate issued by the control plane CA (localhost, 127.0.0.1)"

# TWO ADDRESSES FOR THE SAME ENCLAVE, AND THE DIFFERENCE IS NOT A TYPO.
#
#   api_base_url        — where the PORTAL PROCESS reaches the API. A server-to-server hop
#                         inside the substrate.
#   portal_redirect_uri — where the BROWSER comes back to. A human's address bar, on the
#                         developer's machine, where the portal's port is now published.
#
# They were the same string only while the portal was in host mode and reachable by nobody.
#
# **`host.docker.internal` is NOT the answer here, and it is the obvious wrong guess.**
# Measured from inside the running portal container: `host.docker.internal` resolves to
# 192.168.65.254 and `gateway.docker.internal` to 192.168.65.1 — both Docker Desktop's
# macOS-facing addresses. From a bridge container they route OUT to the developer's machine,
# where the API (host mode) publishes nothing. Both refuse the connection.
#
# The API listens in the LINUX VM's host namespace. The only address that reaches it from a
# bridge container is that bridge's own gateway, derived below rather than hardcoded as
# `172.17.0.1` — the value is stable on this substrate, and a magic constant would be
# indistinguishable from a guess by whoever reads it next.
#
# The durable fix is to publish the API too, at which point this whole hop becomes an
# ordinary published port. That belongs with 019, which needs the API reachable anyway.
API_GATEWAY=$(docker network inspect bridge -f '{{(index .IPAM.Config 0).Gateway}}' 2>/dev/null)
[ -n "$API_GATEWAY" ] || die "could not derive the docker bridge gateway — the portal would start and reach nothing"
nomad job run -detach -var="repo=$REPO" \
  -var="api_base_url=http://${API_GATEWAY}:8081" \
  -var="oidc_issuer=${OIDC_ISSUER}" \
  -var="oidc_authorize_endpoint=${OIDC_AUTHORIZE}" \
  -var="oidc_token_endpoint=${OIDC_TOKEN}" \
  -var="oidc_audience=${OIDC_AUDIENCE}" \
  -var="portal_client_id=${PORTAL_CLIENT_ID}" \
  -var="portal_redirect_uri=https://127.0.0.1:8082/callback" \
  -var="harness_started_by=${HARNESS_STARTED_BY}" \
  "$REPO/infra/jobs/portal.nomad.hcl" >/dev/null \
  && ok "portal submitted (thin client; holds no credential of any kind)" \
  || die "could not submit the portal"

cat <<MSG

    Deployments are settling in the background. Watch them with:

        nomad job status api
        nomad job status portal

    Then open https://127.0.0.1:8082/ and sign in.

MSG

# Which provider is answering, said rather than implied. The two cases differ in whether
# anyone was authenticated at all, and a sign-in page looks much the same either way.
if [ -n "$AUTH0_DOMAIN" ]; then
  cat <<MSG
    You are signing in against ${AUTH0_DOMAIN} — a REAL identity provider. Credentials
    are checked.

    A person still reaches nothing until their claims map to a role. Auth0 carries the
    role in \`permissions\` and the tenant in ${OIDC_TENANT_CLAIM}; the platform grants
    nothing for either until a mapping clears the Control Group. Until then, sign-in
    succeeds and the API answers 403 \`unmapped_claim\` — which is the mechanism working,
    not a misconfiguration.

MSG
else
  cat <<MSG
    The identity provider will accept whoever you say you are, because it is a
    development double and AUTHENTICATES NOBODY. Set AUTH0_DOMAIN in .env to sign in
    against a real one.

MSG
fi
