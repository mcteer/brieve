#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# Runs the durability and API evidence rows as a scheduled workload, and surfaces the result.
#
# The suite holds its own workload identity; no token is passed to it. A process with no
# attested identity cannot obtain a state-store credential, and that failure is correct
# rather than something to work around.

set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
say() { printf '\033[1m==>\033[0m %s\n' "$*"; }

command -v nomad >/dev/null || { echo "nomad is not on PATH" >&2; exit 1; }
curl -sf -o /dev/null --max-time 3 http://127.0.0.1:4646/v1/status/leader \
  || { echo "scheduler unreachable — run: make dev-up" >&2; exit 1; }

# PURGE FIRST. A completed batch job is not re-run by `job run`: Nomad compares an
# identical jobspec against the dead job, changes nothing, and places no allocation. The
# script then read the PREVIOUS allocation's logs and exit code and reported them as this
# run's verdict.
#
# Measured: a real run places a new allocation and takes ~15s; a second run took 3s,
# reported the first run's result, and never executed a row. A merge gate that replays an
# earlier pass is worse than no gate, because it is believed — code can change underneath
# it and it keeps answering green.
#
# This does mean an invocation abandons a run already in flight. That is the right
# trade for a gate: the verdict must belong to the tree in front of you.
# 017: reclaim what a FAILED deployment-lane run left standing, BEFORE this job is placed.
#
# That lane leaves its surfaces running on failure so someone can diagnose them, and it runs
# LAST in `make conformance` — so it cannot free that capacity before this job needs it.
# Locally a prior failure is the normal case, because the lane gets re-run precisely when it
# failed, and without this one red run starves these merge-blocking rows on every subsequent
# one. Here rather than in the Makefile because this script is also invoked directly.
#
# Stops only MARKED surfaces. A portal someone brought up with `portal-up` is untouched.
if [ -r "$REPO/infra/bin/deployment-marks" ]; then
  source "$REPO/infra/bin/deployment-marks"
  stop_marked || say "warning: could not stop every marked deployment surface — placement below may fail"
fi

say "Submitting the durability and API evidence rows as a scheduled workload"
nomad job stop -purge conformance >/dev/null 2>&1 || true

# CAPTURED, not discarded. This was `>/dev/null`, and when the scheduler refused to place
# the job — which it did on every CI run of a branch that added one more workload — the
# only thing anyone saw was `make: *** Error 2`. The placement failure names the exact
# resource that came up short and went straight to the bit bucket, so three rounds of
# diagnosis went into guessing which one it was.
#
# A gate that will not say why it failed costs more than the failure.
if ! run_output="$(nomad job run -var="repo=$REPO" "$REPO/infra/jobs/conformance.nomad.hcl" 2>&1)"; then
  printf '%s\n' "$run_output" >&2
  printf '\033[31mthe conformance job could not be submitted or placed\033[0m — the scheduler'"'"'s reason is above\n' >&2
  # What the node actually has, and what is already holding it. A placement failure is a
  # statement about both, and reading either alone is how three rounds get spent guessing.
  nomad job status conformance 2>&1 | sed -n '/Placement Failure/,/^$/p' >&2 || true
  nomad node status -self 2>&1 | sed -n '/Allocated Resources/,/^$/p' >&2 || true
  nomad node status -self -verbose 2>&1 | grep -E 'cpu\.(numcores|reservablecores|totalcompute)|memory\.totalbytes' >&2 || true
  nomad status 2>&1 >&2 || true
  exit 2
fi

alloc=""
for _ in $(seq 1 30); do
  alloc="$(nomad job status conformance 2>/dev/null | awk '/^[0-9a-f]{8} /{print $1; exit}')"
  [ -n "$alloc" ] && break
  sleep 2
done
[ -n "$alloc" ] || { echo "no allocation was placed for the conformance job" >&2; exit 1; }

# Wait for the task to actually start before tailing. Tailing too early returns a 404
# that reads like a failure and is not one — the image is still downloading.
say "Allocation $alloc — waiting for the task to start"
for _ in $(seq 1 90); do
  state="$(nomad alloc status -json "$alloc" 2>/dev/null \
    | python3 -c 'import json,sys; print((json.load(sys.stdin).get("TaskStates") or {}).get("pytest",{}).get("State","pending"))' 2>/dev/null || echo pending)"
  [ "$state" != "pending" ] && break
  sleep 2
done

# Streamed in the BACKGROUND, and stopped by us when the task is done.
#
# `nomad alloc logs -f` does NOT return when the task dies. Verified against Nomad 2.0.4:
# it was still following an allocation whose task had been `dead` for ten minutes, while
# the same command without -f returned in one second. Waiting on it in the foreground
# therefore hung the gate forever AFTER every row had already passed — which reads as
# "conformance is slow" rather than as a bug, and is the worst place to lose someone's
# afternoon, because nothing is wrong.
say "Streaming"
nomad alloc logs -f "$alloc" pytest 2>&1 &
logs_pid=$!

# Wait for a terminal state before reading the exit code. Reading it while the task is
# still running yields 1 and reports a pass as a failure.
#
# GENEROUSLY bounded, because a cold run is legitimately slow: the workload builds a
# virtualenv and downloads ~50 packages inside the container, which measured at over two
# minutes. The previous 120s bound was invisible only because the foreground `alloc
# logs -f` above never returned — with the stream no longer blocking, a cold run overran
# it and the gate reported RED on 31 rows that had all passed.
wait_secs="${CONFORMANCE_WAIT_SECS:-900}"
deadline=$(( SECONDS + wait_secs ))
state=running
while [ "$SECONDS" -lt "$deadline" ]; do
  state="$(nomad alloc status -json "$alloc" 2>/dev/null \
    | python3 -c 'import json,sys; print((json.load(sys.stdin).get("TaskStates") or {}).get("pytest",{}).get("State","running"))' 2>/dev/null || echo running)"
  [ "$state" = "dead" ] && break
  sleep 2
done

# Drain before stopping. The task reaches `dead` before its last chunk has necessarily
# crossed the stream, and the line most worth not truncating is pytest's summary — the
# one someone needs when the gate is red.
sleep 2
kill "$logs_pid" 2>/dev/null || true
wait "$logs_pid" 2>/dev/null || true

# Running out of patience is NOT a verdict on the rows, and must not be reported as one.
# A gate that says "failed" when it means "I stopped waiting" sends someone to debug
# passing tests — exit 2, distinct from the rows' own 1, and say which it is.
if [ "$state" != "dead" ]; then
  printf '\033[31mno verdict\033[0m — task still %s after %ss; the rows did not fail, this run did not finish: nomad alloc logs %s pytest\n' \
    "$state" "$wait_secs" "$alloc" >&2
  exit 2
fi

# The exit status is the gate. Allocation logs are a worse debugging surface than a local
# run, so at minimum the verdict must be unambiguous.
status="$(nomad alloc status -json "$alloc" | python3 -c '
import json,sys
a=json.load(sys.stdin)
for _, tg in (a.get("TaskStates") or {}).items():
    pass
ts=(a.get("TaskStates") or {}).get("pytest") or {}
ev=[e for e in (ts.get("Events") or []) if e.get("Type")=="Terminated"]
print(ev[-1].get("ExitCode", 1) if ev else 1)
')"

if [ "$status" = "0" ]; then
  printf '\033[32mdurability rows passed\033[0m — under an attested workload identity, no token anywhere\n'
else
  printf '\033[31mdurability rows failed\033[0m (exit %s) — logs: nomad alloc logs %s pytest\n' "$status" "$alloc" >&2
fi
exit "$status"
