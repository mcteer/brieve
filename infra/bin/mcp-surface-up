#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# Bring up the SERVED MCP surface — 019.
#
# Separate from the supervisory loop `enclave-up` registers. FR-015a requires the two be
# independently available, and two jobs give that structurally: stopping this one leaves
# the sweeper resuming suspended runs, and stopping the sweeper leaves this one answering.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
ok() { printf '    \033[32mok\033[0m %s\n' "$*"; }
die() {
  printf '\033[31mthe MCP surface could not start:\033[0m %s\n' "$*" >&2
  exit 1
}

# READS `.env` THE WAY EVERY OTHER SCRIPT HERE DOES, and tolerates a missing key.
#
# `grep` matching nothing exits 1, `pipefail` propagates it, and `VAR="$(env_val KEY)"` then
# kills the script under `set -e` — which is how `portal-up` died on its first line in any
# environment whose `.env` lacked a key it asked for. Locally that never happened, because
# the key was always there.
env_val() {
  [ -f "$REPO/.env" ] || return 0
  grep "^$1=" "$REPO/.env" 2>/dev/null | head -1 | cut -d= -f2- | sed -e 's/^"//' -e 's/"$//' || true
}

say "MCP surface"

# THE COORDINATES, AND THEIR FALLBACKS, WHICH ARE THE PART THAT MATTERS.
#
# `enclave-up` writes VAULT_ROOT_TOKEN into `.env` but only EXPORTS the address and the CA
# path — so a developer's `.env` has all three and CI's has one. Reading all three from
# `.env` works perfectly on a laptop and fails in CI. That exact defect shipped in
# `portal-up` and was caught only by running it against a deliberately minimal `.env`.
#
# The defaults are `enclave-up`'s own, copied rather than invented: if it moves the CA, this
# is wrong in the same direction, which is easier to find than being wrong in a new one.
VAULT_ADDR_VAL="$(env_val VAULT_ADDR)"; VAULT_ADDR_VAL="${VAULT_ADDR_VAL:-https://127.0.0.1:8200}"
VAULT_CACERT_VAL="$(env_val VAULT_CACERT)"; VAULT_CACERT_VAL="${VAULT_CACERT_VAL:-$REPO/.enclave/ca.pem}"

# A DEVELOPER GETS A PROVIDER WITHOUT KNOWING ONE EXISTS (023 FR-003a).
#
# `make dev-up` runs `enclave-up` only — it starts neither this surface nor the development
# identity provider, and the Makefile keeps the surfaces separate from it on purpose. So the
# obligation belongs here: this is the command someone runs when they intend to connect an
# editor, and needing to also start a second process they were never told about is the same
# "step you had to already know" that pasting a token was.
#
# Opt-in via DEV_IDP, so this never starts a fake provider beside a real one. Already
# listening is success, not a conflict — `mcp-surface-conformance` starts its own and then
# calls this script.
if [ -n "${DEV_IDP:-}" ] || [ -n "${OIDC_ISSUER_OVERRIDE:-}" ]; then
  DEV_IDP_PORT_VAL="${DEV_IDP_PORT:-8090}"
  # SET BEFORE THE BRANCH, not inside it. This lived in the `else` arm, so a provider that was
  # already listening took the early exit and left the override empty — and the surface then fell
  # through to the real provider from `.env` and refused every development token as
  # `unverifiable_identity`. It worked the first time only because nothing was listening yet,
  # which is the worst way for a bug like this to behave.
  OIDC_ISSUER_OVERRIDE="${OIDC_ISSUER_OVERRIDE:-http://127.0.0.1:${DEV_IDP_PORT_VAL}}"
  if curl -sf "http://127.0.0.1:${DEV_IDP_PORT_VAL}/jwks" >/dev/null 2>&1; then
    ok "development provider already listening on ${DEV_IDP_PORT_VAL}"
  else
    (
      cd "$REPO"
      DEV_IDP_HOST=0.0.0.0 DEV_IDP_PORT="$DEV_IDP_PORT_VAL" \
        DEV_IDP_ISSUER="$OIDC_ISSUER_OVERRIDE" \
        DEV_IDP_TOKEN_MINUTES="${DEV_IDP_TOKEN_MINUTES:-480}" \
        uv run --extra surfaces python -m tests.harness.dev_idp \
        >/tmp/brieve-dev-idp.log 2>&1 &
    )
    for _ in $(seq 1 30); do
      curl -sf "http://127.0.0.1:${DEV_IDP_PORT_VAL}/jwks" >/dev/null 2>&1 && break
      sleep 1
    done
    curl -sf "http://127.0.0.1:${DEV_IDP_PORT_VAL}/jwks" >/dev/null 2>&1 \
      || die "the development provider never answered — see /tmp/brieve-dev-idp.log"
    ok "development provider started on ${DEV_IDP_PORT_VAL}"
  fi
  : "${OIDC_JWKS_URI_OVERRIDE:=http://host.docker.internal:${DEV_IDP_PORT_VAL}/jwks}"
  export OIDC_JWKS_URI_OVERRIDE
fi

# THE LANE SUPPLIES ITS OWN ISSUER, and nothing else may.
#
# `mcp-surface-conformance` points the surface at the development provider it started, whose
# JWKS the surface must fetch from inside a bridge container. Outside the lane this is unset
# and the real provider from `.env` is used — so the override is a lane affordance rather
# than a way to weaken a deployed surface by exporting a variable.
if [ -n "${OIDC_ISSUER_OVERRIDE:-}" ]; then
  OIDC_ISSUER="$OIDC_ISSUER_OVERRIDE"
  # THE KEYS ARE FETCHED FROM A DIFFERENT ADDRESS THAN THE ISSUER NAMES, and that is correct.
  #
  # This line used to read `OIDC_JWKS_URI="${OIDC_ISSUER_OVERRIDE}/jwks"`, deriving one from the
  # other. `src/surfaces/mcp/served.py` keeps them apart deliberately: the issuer is a string it
  # COMPARES against a token's `iss`, the JWKS URI a location it FETCHES. The surface never
  # resolves the issuer at all.
  #
  # That distinction is what lets a browser login work. A client on the host must resolve the
  # advertised issuer, and `host.docker.internal` does not resolve there — it is a container's
  # name for the host. So the issuer is advertised as a loopback address the client can reach,
  # while the keys stay on the name the container can reach. The identities match because the
  # provider mints exactly the string the surface compares; only the addresses differ.
  OIDC_JWKS_URI="${OIDC_JWKS_URI_OVERRIDE:-${OIDC_ISSUER_OVERRIDE}/jwks}"
  # The development provider's own audience. Empty would leave the verifier expecting
  # "harness-api" — its default — while every minted token carries this, and the surface
  # would refuse every caller with an audience mismatch that names the token.
  OIDC_AUDIENCE="harness-api"
  OIDC_TENANT_CLAIM="tenant"
  ok "issuer overridden for a lane: ${OIDC_ISSUER} (keys from ${OIDC_JWKS_URI})"
else
  AUTH0_DOMAIN="$(env_val AUTH0_DOMAIN)"
  [ -n "$AUTH0_DOMAIN" ] || die "AUTH0_DOMAIN is not in .env — this surface verifies CALLERS and will not start without an issuer"

# The trailing slash is not optional and not cosmetic: Auth0's `iss` carries one, and a
# verifier configured without it rejects every token with an issuer mismatch that names the
# issuer rather than the slash.
  OIDC_ISSUER="https://${AUTH0_DOMAIN}/"
  OIDC_JWKS_URI="https://${AUTH0_DOMAIN}/.well-known/jwks.json"
  OIDC_AUDIENCE="$(env_val AUTH0_API_AUDIENCE)"
  OIDC_TENANT_CLAIM="$(env_val OIDC_TENANT_CLAIM)"
  OIDC_TENANT_CLAIM="${OIDC_TENANT_CLAIM:-tenant}"
fi
HARNESS_STARTED_BY="${HARNESS_STARTED_BY:-}"

ok "issuer ${OIDC_ISSUER}"

# 027. Which model `ask` may call, from .env. Unset leaves the surface with no model, which
# answers 503 rather than answering from the corpus alone — an honest state, not a broken one.
# The credential is never passed here; the surface reads it from the trust store per ask.
ASK_MODEL="$(env_val ASK_MODEL)"
# 043: the relevance judge's model, and NEVER the same value as ASK_MODEL —
# ADR-0067 forbids a model judging its own output.
RELEVANCE_MODEL="$(env_val RELEVANCE_MODEL)"

nomad job run -detach -var="repo=$REPO" \
  -var="ask_model=${ASK_MODEL}" \
  -var="relevance_model=${RELEVANCE_MODEL}" \
  -var="oidc_issuer=${OIDC_ISSUER}" \
  -var="oidc_jwks_uri=${OIDC_JWKS_URI}" \
  -var="oidc_audience=${OIDC_AUDIENCE}" \
  -var="oidc_tenant_claim=${OIDC_TENANT_CLAIM}" \
  -var="harness_started_by=${HARNESS_STARTED_BY}" \
  "$REPO/infra/jobs/mcp-surface.nomad.hcl" >/dev/null \
  && ok "mcp-surface submitted (bridge mode; the port is published to this machine)" \
  || die "could not submit the mcp-surface job"

cat <<'NOTE'

    The surface answers on http://127.0.0.1:8083/mcp once its allocation is healthy.

    It acts AS THE CALLING USER and never as itself, so a client presents its own bearer
    token from the same identity provider the portal signs people in against. A token that
    maps to no role is refused — which is the mechanism working, not a misconfiguration.

    IT SERVES THE TRANSPORT. Since 020 a dispatched run also consults the model its
    definition binds, so what a client sees is a model choosing, governance intercepting the
    choice, and evidence being written about both. `get_run_report` (021) compiles that into
    an account whose every claim traces to a record.

    This text claimed the opposite until 021 — "a dispatched run still selects tools by a
    scripted sequence (ROADMAP gap 0e)" — which was true when it was written and stopped
    being true the day 0e closed.

NOTE
