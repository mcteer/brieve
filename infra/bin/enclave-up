#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# Brings up the enclave in ADR-0048's order: Terraform -> Vault -> Nomad -> harness.
# Each link is established before the one that depends on it, and that is the only
# ordering that terminates — the scheduler is itself a client of the trust store.
#
# Idempotent. Re-running against a configured environment UNSEALS; it never
# re-initialises. Re-initialising discards the raft store and invalidates every
# credential derived from it, which is the most expensive mistake available here.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
ENV_DIR="${ENCLAVE_ENV:-$REPO/infra/environments/dev}"
NOMAD_ADDR="${NOMAD_ADDR:-http://127.0.0.1:4646}"

# The listener's scheme is a PROPERTY OF THE ENVIRONMENT, not a constant.
#
# Once TLS has been bootstrapped, tls.auto.tfvars is auto-loaded (deliberately — see
# section 4b) and Terraform brings the listener up on HTTPS. A probe hardcoded to http
# then fails against a store that is working perfectly. That is exactly what happens when
# the container is lost but the TLS material survives: this script recreates it on https,
# probes http, and reports "trust store is not answering" — which names neither TLS nor
# the scheme, and sends the reader to `docker logs` where nothing is wrong.
#
# Detected from the tfvars file rather than from ENCLAVE_TLS, because it is the tfvars
# file that decides: the certificate reaches the substrate module through auto-loading,
# so ENCLAVE_TLS=false does NOT put an already-bootstrapped listener back on plaintext.
CA_FILE="$REPO/.enclave/ca.pem"
if [ -f "$ENV_DIR/tls.auto.tfvars" ] && [ -f "$CA_FILE" ]; then
  export VAULT_ADDR="${VAULT_ADDR:-https://127.0.0.1:8200}"
  export VAULT_CACERT="${VAULT_CACERT:-$CA_FILE}"
else
  export VAULT_ADDR="${VAULT_ADDR:-http://127.0.0.1:8200}"
fi

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
ok()  { printf '    \033[32mok\033[0m %s\n' "$*"; }
die() { printf '\033[31mmissing prerequisite:\033[0m %s\n' "$*" >&2; exit 1; }
# For the things a person may want but no gate needs. `die` stops the platform; this says
# something is missing and lets the rest come up — the distinction 012 had to learn when a
# dev-only identity provider blocked the enclave CI lane.
warn() { printf '    \033[33mwarn\033[0m %s\n' "$*" >&2; }

# .env values are quoted. Passing the quotes through made the trust store reject its
# licence with "error decoding version: expected integer", which names neither quoting
# nor the licence.
env_val() {
  [ -f "$REPO/.env" ] || die ".env not found at $REPO/.env"
  grep "^$1=" "$REPO/.env" | head -1 | cut -d= -f2- | sed -e 's/^"//' -e 's/"$//'
}

env_set() {
  KEY="$1" VAL="$2" python3 - "$REPO/.env" <<'PY'
import os, re, sys
p, k, v = sys.argv[1], os.environ["KEY"], os.environ["VAL"]
t = open(p).read()
line = f'{k}="{v}"'
t = re.sub(rf'^{k}=.*$', line, t, flags=re.M) if re.search(rf'^{k}=', t, re.M) else t.rstrip("\n") + "\n" + line + "\n"
open(p, "w").write(t)
PY
}

# Probes the listener with whatever CA is in force AT CALL TIME. Reading VAULT_CACERT
# inside the function rather than baking flags into a variable is load-bearing: section 4b
# moves the listener from plaintext to TLS mid-run, and a probe that captured its flags
# earlier would keep speaking the scheme the run started with.
seal_status_ok() {
  if [ -n "${VAULT_CACERT:-}" ]; then
    curl -sf --cacert "$VAULT_CACERT" -o /dev/null --max-time 2 "$VAULT_ADDR/v1/sys/seal-status"
  else
    curl -sf -o /dev/null --max-time 2 "$VAULT_ADDR/v1/sys/seal-status"
  fi
}

# ---------------------------------------------------------------- prerequisites
# Each failure NAMES what is missing. "Bring-up failed" withholds the diagnosis this
# script has already performed.
# How the trust store addresses the host is a substrate difference. Docker Desktop
# provides `host.docker.internal`; Linux Docker does not, and its published ports bind one
# interface, so a bridged trust store resolves the host and is refused by it. Set
# ENCLAVE_VAULT_HOST_NETWORK=true there.
NET_ARGS=()
[ "${ENCLAVE_VAULT_HOST_NETWORK:-false}" = "true" ] && NET_ARGS=(-var vault_host_network=true)

say "Prerequisites"
for bin in docker nomad vault terraform python3; do
  command -v "$bin" >/dev/null || die "$bin is not on PATH — see CONTRIBUTING.md"
done
docker info >/dev/null 2>&1 || die "Docker is not running — start Docker Desktop"

# `host.docker.internal` must resolve for a HOST-NETWORKED CONTAINER.
#
# Nomad allocations here run with `network_mode = host`, and reach the trust store and
# state store by that name. Where "host" is depends on the substrate, which is why this
# is checked the way a workload experiences it rather than by resolving on this machine:
#
#   - Docker Desktop runs containers inside a Linux VM and provides the name there. The
#     macOS host itself does NOT resolve it, and does not need to.
#   - Linux Docker shares the machine's own network namespace and provides nothing, so
#     the name has to exist in /etc/hosts.
#
# A check against the local resolver would therefore fail on every Docker Desktop
# machine while the enclave worked perfectly — which is how this check was first written,
# and what running it caught.
#
# Checked rather than fixed: the fix needs root, and a script that silently edits
# /etc/hosts is a worse thing to run than one that tells you what to do.
if ! docker run --rm --network host alpine:3 getent hosts host.docker.internal >/dev/null 2>&1; then
  die "host.docker.internal does not resolve inside a host-networked container.

  Docker Desktop provides it; Linux Docker does not. Scheduled workloads use host
  networking and reach the trust store and state store by that name, so without it they
  fail later with a connection error that names DNS and not this.

  Add it once:
      echo '127.0.0.1 host.docker.internal' | sudo tee -a /etc/hosts"
fi
LICENSE="$(env_val VAULT_ENT_LICENSE)"
[ -n "$LICENSE" ] || die "VAULT_ENT_LICENSE is absent from .env"
[ -d "$ENV_DIR" ] || die "environment root $ENV_DIR does not exist"
ok "tooling, Docker, licence, environment root"

# ---------------------------------------------------------------- 1. scheduler
# First: the trust store fetches the scheduler's JWKS at configure time, and the
# scheduler runs the state store. An inverted order fails at cold start.
# A leader answering is NOT enough. The agent can keep serving HTTP while its client
# node is down — which is what happens when the advertised RPC address goes stale after
# a network change. Jobs then register, report "running", and never place an allocation,
# so anything waiting on the workload waits forever.
scheduler_ready() {
  curl -sf --max-time 3 "$NOMAD_ADDR/v1/nodes" 2>/dev/null \
    | python3 -c 'import json,sys; print(any(n.get("Status")=="ready" for n in json.load(sys.stdin)))' 2>/dev/null \
    | grep -q True
}

say "Scheduler"
if scheduler_ready; then
  ok "already running, with a ready client node"
else
  # The container driver refuses volume mounts unless the AGENT enables them. A correct
  # jobspec fails anyway, with a message pointing at the jobspec.
  nohup nomad agent -dev -bind 0.0.0.0 -config="$REPO/infra/nomad/client.hcl" \
    > "${TMPDIR:-/tmp}/brieve-nomad.log" 2>&1 &
  for _ in $(seq 1 45); do scheduler_ready && break; sleep 1; done
  scheduler_ready \
    || die "scheduler has no ready client node — log: ${TMPDIR:-/tmp}/brieve-nomad.log. A stale advertised RPC address is the usual cause; see infra/nomad/client.hcl"
  ok "started, client node ready"
fi

# ---------------------------------------------------------------- 2. state store
say "State store"
cd "$REPO/infra"
if nomad job status postgres 2>/dev/null | grep -q "^Status *= *running"; then
  ok "already scheduled"
else
  nomad job run jobs/postgres.nomad.hcl >/dev/null
  ok "scheduled"
fi
for _ in $(seq 1 60); do nc -z 127.0.0.1 5432 2>/dev/null && break; sleep 1; done
nc -z 127.0.0.1 5432 2>/dev/null || die "state store is not listening — try: nomad job status postgres"
ok "listening (data on brieve-dev-pgdata, which outlives the allocation)"

# ---------------------------------------------------------------- 3. trust store
say "Trust store"
cd "$ENV_DIR"
export TF_VAR_vault_license="$LICENSE"
[ -d .terraform ] || terraform init -input=false >/dev/null

# Stopping the container drops it from state on the next refresh, so a plain apply then
# tries to CREATE a container whose name is taken. Reconcile before applying.
if docker container inspect brieve-dev-vault >/dev/null 2>&1; then
  docker start brieve-dev-vault >/dev/null 2>&1 || true
  if ! terraform state list 2>/dev/null | grep -qx 'module.substrate.docker_container.vault'; then
    terraform import -input=false -var vault_token=placeholder \
      module.substrate.docker_container.vault \
      "$(docker container inspect -f '{{.ID}}' brieve-dev-vault)" >/dev/null 2>&1 \
      && ok "re-imported the existing container into state"
  fi
fi

terraform apply -input=false -auto-approve \
  -target=module.substrate -var vault_token=placeholder \
  ${NET_ARGS[@]+"${NET_ARGS[@]}"} >/dev/null
for _ in $(seq 1 30); do seal_status_ok && break; sleep 1; done
seal_status_ok \
  || die "trust store is not answering at $VAULT_ADDR — try: docker logs brieve-dev-vault"

# `vault status` EXITS NONZERO when the store is sealed or uninitialised, while still
# printing perfectly valid JSON. Under `set -o pipefail` the old one-liner therefore ran
# BOTH python's `False` and the `|| echo False` fallback, and `initialized` became the
# two-line string "False\nFalse" — which matches neither branch below. A true first run
# thus took the "already initialised" path and died unsealing with an empty key.
#
# Capture first, parse second. `printf` cannot fail, so the fallback now fires only when
# there is genuinely nothing to parse — and when python does fail it writes no stdout,
# so the two cannot both contribute.
status_json="$(vault status -format=json 2>/dev/null || true)"
initialized="$(printf '%s' "$status_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["initialized"])' 2>/dev/null || echo False)"
if [ "$initialized" = "False" ]; then
  say "Uninitialised — first run"
  init_json="$(vault operator init -key-shares=1 -key-threshold=1 -format=json)"
  env_set VAULT_UNSEAL_KEY "$(printf '%s' "$init_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["unseal_keys_b64"][0])')"
  env_set VAULT_ROOT_TOKEN "$(printf '%s' "$init_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["root_token"])')"
  ok "initialised; unseal key and root token written to .env (1-of-1 — development only)"
else
  ok "already initialised — unsealing, never re-initialising"
fi

if vault status 2>/dev/null | grep -q "^Sealed *false"; then
  ok "already unsealed"
else
  vault operator unseal "$(env_val VAULT_UNSEAL_KEY)" >/dev/null \
    || die "unseal failed — is VAULT_UNSEAL_KEY the key for volume brieve-dev-vault-data?"
  ok "unsealed"
fi
for _ in $(seq 1 20); do vault status 2>/dev/null | grep -q "^HA Mode *active" && break; sleep 1; done

# ---------------------------------------------------------------- 4. trust fabric
# NEVER apply against a sealed store. The provider cannot read, so Terraform concludes
# the resources are gone and drops them from state; the next apply then tries to create
# mounts that already exist, and has crashed the provider outright.
vault status 2>/dev/null | grep -q "^Sealed *false" \
  || die "trust store is sealed — refusing to apply, which would corrupt Terraform state"

say "Trust fabric"
# TLS is ON by default. The path you develop against should be the path that ships;
# an opt-in security property is one most environments never opt into.
#
# ENCLAVE_TLS=false exists for diagnosing the transport itself — when the question is
# "is TLS the problem", not "should we have TLS".
TLS_ARGS=()
[ "${ENCLAVE_TLS:-true}" = "true" ] && TLS_ARGS=(-var enable_tls=true)

terraform apply -input=false -auto-approve -var vault_token="$(env_val VAULT_ROOT_TOKEN)" ${TLS_ARGS[@]+"${TLS_ARGS[@]}"} ${NET_ARGS[@]+"${NET_ARGS[@]}"} >/dev/null
ok "workload identity auth, ceiling policies, agent registry, database engine, dynamic role"

# ---------------------------------------------------------------- 4b. transport
#
# The bootstrap circularity, resolved the only way it can be: the trust store cannot
# start with a certificate from a CA that is not yet serving, so it starts plaintext,
# issues its own listener certificate, and is then restarted holding it.
#
# The restart SEALS it. That is not a failure — it is what happens to a raft-backed store
# whose process is replaced — but it means unsealing again is part of the sequence rather
# than something a reader has to notice.
if [ "${ENCLAVE_TLS:-true}" = "true" ]; then
  say "Transport security"
  cert="$(terraform output -raw listener_certificate 2>/dev/null || true)"
  if [ -z "$cert" ]; then
    die "TLS was requested but no listener certificate was issued — check the PKI mount"
  fi
  key="$(terraform output -raw listener_private_key)"
  ca="$(terraform output -raw listener_ca_chain)"

  mkdir -p "$REPO/.enclave"
  printf '%s\n' "$ca" > "$REPO/.enclave/ca.pem"
  chmod 600 "$REPO/.enclave/ca.pem"
  ok "CA written to .enclave/ca.pem (public material; clients trust this)"

  # Written as an auto-loaded tfvars file rather than passed on the command line.
  #
  # Passing it per-invocation would mean a bare `terraform apply` — the obvious thing to
  # run — sees no certificate, computes the scheme as http, and SILENTLY REVERTS THE
  # LISTENER TO PLAINTEXT. A security property that switches itself off when someone
  # runs the normal command is not a security property.
  umask 077
  cat > "$ENV_DIR/tls.auto.tfvars" <<TFVARS
# Generated by enclave-up. Gitignored (infra/.gitignore covers *.tfvars).
# Auto-loaded, so TLS survives a bare \`terraform apply\` instead of switching itself off.
enable_tls      = true
ca_cert_file    = "$REPO/.enclave/ca.pem"
tls_certificate = <<CERT
$cert
CERT
tls_private_key = <<KEY
$key
KEY
TFVARS
  ok "TLS material persisted to the root as auto-loaded vars"

  terraform apply -input=false -auto-approve \
    -var vault_token="$(env_val VAULT_ROOT_TOKEN)" \
    -target=module.substrate ${NET_ARGS[@]+"${NET_ARGS[@]}"} >/dev/null
  ok "listener switched to TLS, issued by the control plane's own CA"

  export VAULT_ADDR="https://127.0.0.1:8200"
  export VAULT_CACERT="$REPO/.enclave/ca.pem"
  for _ in $(seq 1 30); do seal_status_ok && break; sleep 1; done

  # Replacing the container seals the store. Unseal again, or everything after this
  # fails with an error that names the seal and not the restart that caused it.
  if ! vault status 2>/dev/null | grep -q "^Sealed *false"; then
    vault operator unseal "$(env_val VAULT_UNSEAL_KEY)" >/dev/null \
      || die "unseal after the TLS restart failed"
    ok "unsealed again after the restart"
  fi

  env_set VAULT_ADDR "$VAULT_ADDR"
  env_set VAULT_CACERT "$VAULT_CACERT"
  ok "VAULT_ADDR and VAULT_CACERT written to .env — every client moves with the listener"
fi

# ---------------------------------------------------------------- 4a. evidence schema
#
# Applied after the transport settles and before anything draws evidence credentials,
# because the evidence role's creation_statements name `audit_entries` explicitly. Vault
# evaluates those statements when it issues a credential, not when Terraform creates the
# role — so if the table does not exist yet, credential issuance FAILS OUTRIGHT rather
# than degrading. An ordering requirement nothing owns is a comment; this owns it.
#
# Applied under the harness (run) role, which is the only one holding CREATE ON SCHEMA
# public. The evidence role could not create this schema even if asked to, which is the
# point of it.
#
# Placed after the TLS switch rather than before it because that restart replaces the
# container and reseals the store: a step that talked to Vault beforehand would be talking
# to a listener about to be torn down. Nothing draws an evidence credential during
# bring-up, so the ordering requirement is still satisfied.
say "Evidence store"
# The CLI needs a token; the trust-fabric apply above passes one to Terraform as a var and
# never exports it. enclave-verify does the same thing at its line 47 — worth matching
# rather than assuming the environment carries it.
export VAULT_TOKEN="${VAULT_TOKEN:-$(env_val VAULT_ROOT_TOKEN)}"

# Unsealed is not the same as ready, and this is the first place that difference bites.
# `vault operator unseal` returns as soon as the key is accepted; the store then becomes
# active and remounts its backends, and a request for a dynamic credential arriving inside
# that window fails against a database engine that is not serving yet. The TLS restart
# above puts a fresh unseal directly in front of this call, so the window is not a rare
# one — it is where this call always lands.
#
# It presented as an intermittent CI failure with a message naming the credential, which
# sent debugging toward Vault's database configuration rather than at a restart four lines
# earlier. Hence both halves of the fix: wait for ready, and **report what Vault actually
# said** when the wait runs out.
ev_creds=""
mint_error=""
for _ in $(seq 1 30); do
  if ev_creds="$(vault read -format=json database/creds/harness 2>/tmp/enclave-mint-err)"; then
    [ -n "$ev_creds" ] && break
  fi
  mint_error="$(tr -d '\r' < /tmp/enclave-mint-err | tail -3)"
  ev_creds=""
  sleep 1
done
if [ -z "$ev_creds" ]; then
  [ -n "$mint_error" ] && printf '  %s\n' "$mint_error" >&2
  die "could not mint a harness credential to apply the evidence schema (30s)"
fi
EV_USER="$(printf '%s' "$ev_creds" | python3 -c 'import json,sys; print(json.load(sys.stdin)["data"]["username"])')"
EV_PASS="$(printf '%s' "$ev_creds" | python3 -c 'import json,sys; print(json.load(sys.stdin)["data"]["password"])')"
# SET ROLE before the DDL. Every dynamic credential is a distinct role, so a table
# created under one is owned by an ephemeral user that will not exist next week — and the
# next credential then fails DDL with "must be owner of table", including on
# `CREATE INDEX IF NOT EXISTS`, which checks ownership before existence. 005 paid for this
# once already in the durability schema; the same trap is reachable from every new store.
# Both schemas, in one pass. The dependency tables are here for the same reason the
# evidence ones are: the evidence role's statements NAME them, and a statement naming a
# table that does not exist fails outright rather than degrading. That has now bitten
# three times — 008's audit_entries, and both dependency tables here — so schemas that any
# role statement references get applied at bring-up, not on first use by whatever happens
# to start first.
#
# **Four times now.** 012 added `run_inputs`, which the agent-run entrypoint reads at every
# run start, and left it to the API service's migrate-on-boot. The API had never been
# deployed before 012, so on an enclave brought up beforehand the table did not exist and
# every dispatched run died with `relation "run_inputs" does not exist`. The rule this
# comment already stated is the fix, applied one schema wider.
# 013 adds the eval schema here rather than anywhere later, on the rule above: results
# are written by the gate lane and read at review, and a table created by whichever
# ephemeral credential ran the first gate would strand every later one.
#
# **FIVE TIMES, AND THE FIFTH WAS THE SCHEMA THAT TAUGHT THE RULE.** 014 went looking for
# the durability schema in this list — its task said "verify the new DDL rides that block"
# — and it was not here. Every other store was added after being caught; durability was
# the one still on `PostgresDurabilityProvider.migrate()`, i.e. on first use by whichever
# process happens to start first. It survived because a dispatched run's entrypoint calls
# `migrate()` early and the conformance conftest calls it too, so something always
# happened to run it in time. That is luck holding a rule's place, and 014 removes the
# luck: it adds the first ALTER TABLE in the repository (`resume_count`), and an additive
# column that applies only when someone remembers to call `migrate()` is a column that is
# absent exactly when a resumed run needs it.
if { echo "SET ROLE brieve;"; cat "$REPO/src/core/audit/evidence_schema.sql"; \
     cat "$REPO/src/core/dependencies/schema.sql"; \
     cat "$REPO/src/core/runs/schema.sql"; \
     cat "$REPO/src/core/threads/schema.sql"; \
     cat "$REPO/src/core/evals/schema.sql"; \
     cat "$REPO/src/core/durability/schema.sql"; } \
   | docker run --rm -i -e PGPASSWORD="$EV_PASS" --network host postgres:17-alpine \
     psql -h 127.0.0.1 -p 5432 -U "$EV_USER" -d brieve -v ON_ERROR_STOP=1 -q >/dev/null 2>&1; then
  ok "evidence, dependency, run-index, thread, eval, and durability schemas applied"
else
  die "evidence schema failed to apply — the evidence role cannot issue credentials without it"
fi

# The tenant every audit entry carries. Runs started without a surface — the adapter, the
# older suites — have no identity provider to draw a claim from, and core refuses rather
# than inventing a value, so the deployment names one.
# Written only if absent, so a deployment that has chosen its own tenant keeps it across
# re-runs. Everything else in this script is idempotent for the same reason.
if [ -z "$(env_val HARNESS_DEFAULT_TENANT)" ]; then
  env_set HARNESS_DEFAULT_TENANT "tenant-local"
fi
ok "HARNESS_DEFAULT_TENANT=$(env_val HARNESS_DEFAULT_TENANT)"

# ---------------------------------------------------------------- 4c. run job
# The parameterized job a dispatched run becomes. Registered here rather than left to
# whoever runs the tests, because `NomadDispatcher` submitting to a job that does not
# exist fails at the moment a customer starts their first run — not at bring-up, where it
# would be noticed.
say "MCP service"
# The persistent component. Registered at bring-up rather than left to whoever remembers,
# because a missing MCP service is invisible until suspended runs stop resuming — which
# looks like a hang and is not one.
nomad job run -var="repo=$REPO" "$REPO/infra/jobs/mcp.nomad.hcl" >/dev/null 2>&1 \
  && ok "mcp registered (persistent; hosts the health checker and the sweeper)" \
  || die "could not register the mcp service — health checks and the sweeper would not run"

say "Run job"
nomad job run -var="repo=$REPO" "$REPO/infra/jobs/agent-run.nomad.hcl" >/dev/null 2>&1 \
  && ok "agent-run registered (parameterized; one allocation and one identity per run)" \
  || die "could not register the agent-run job — dispatched runs would have nothing to run"

# ---------------------------------------------------------------- 4d. the surfaces
# The API and the portal are NOT registered here. `make portal-up` does it.
#
# They were, briefly, and the CI enclave lane taught the lesson twice in one run. First
# `nomad job run` on a service job BLOCKS until its deployment settles, so a portal that
# could not start held bring-up for ten minutes. Then the two extra `cores = 1`
# reservations left the conformance job unplaceable, and the durability rows — the actual
# merge-blocking work of that lane — never ran.
#
# The distinction that fixes it: bring-up stands up the PLATFORM, and the gates need Vault,
# Nomad, Postgres, the MCP service, and agent-run. The API and portal serve a PERSON
# walking through the quickstart in a browser, which is a deliberate act with its own
# target and its own resource cost. Making it explicit is also more honest — the portal
# needs a development identity provider that authenticates nobody, and that should be
# something someone chooses to run.

# ---------------------------------------------------------------- 5. the contract
# Verification runs BEFORE success is reported. Otherwise the contract describes intent
# rather than state.
say "Verifying"
"$REPO/infra/bin/enclave-verify"

cat <<EOF

  Enclave up — and the contract above was checked, not assumed.

    Trust store  $VAULT_ADDR
    Scheduler    $NOMAD_ADDR
    State store  127.0.0.1:5432

  Credentials are minted per workload; there is no database password to export.
  Stop without destroying anything:  make dev-down
EOF
